# ─────────────────────────────────────────────────────────────
#  NetPulse ISP Manager — Production Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Node / server ─────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://netpulse:CHANGE_ME@localhost:5432/netpulse

# ── Authentication (better-auth) ───────────────────────────────
# Generate secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=CHANGE_ME_use_openssl_rand_hex_32
# Full URL of your server (used for auth callbacks)
BETTER_AUTH_URL=https://yourdomain.com
# Consecutive incorrect current-password attempts allowed before a staff
# account is locked from further password changes (default: 5).
PASSWORD_CHANGE_MAX_ATTEMPTS=5

# ── Session ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
SESSION_SECRET=CHANGE_ME_use_openssl_rand_hex_64

# ── Frontend ──────────────────────────────────────────────────
# Absolute path to the built Vite frontend (set by setup.sh automatically)
# Only needed if NOT using nginx to serve static files
FRONTEND_DIST_PATH=/opt/netpulse/artifacts/isp-portal/dist/public

# ── Frontend build-time variables (used by setup.sh during `vite build`) ──
# These are baked into the frontend bundle at build time — not runtime
VITE_BETTER_AUTH_URL=https://yourdomain.com

# Your domain or server IP (for nginx / HTTPS)
SERVER_DOMAIN=yourdomain.com
