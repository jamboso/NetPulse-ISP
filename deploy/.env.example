# ─────────────────────────────────────────────────────────────
#  NetPulse ISP Manager — Production Environment Variables
#  Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── Node / server ─────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── Database ──────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL=postgresql://netpulse:CHANGE_ME@localhost:5432/netpulse

# ── Clerk Authentication ───────────────────────────────────────
# Get these from https://dashboard.clerk.com → your production app → API Keys
CLERK_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLERK_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── Session ───────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
SESSION_SECRET=CHANGE_ME_use_openssl_rand_hex_64

# ── Frontend ──────────────────────────────────────────────────
# Absolute path to the built Vite frontend (set by setup.sh automatically)
# Only needed if NOT using nginx to serve static files
FRONTEND_DIST_PATH=/opt/netpulse/artifacts/isp-portal/dist/public

# ── Frontend build-time variables (used by setup.sh during `vite build`) ──
# These are baked into the frontend bundle at build time — not runtime
VITE_CLERK_PUBLISHABLE_KEY=pk_live_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Clerk proxy URL — routes Clerk traffic through your own domain.
# Set to: https://yourdomain.com/api/__clerk
# Leave blank to use Clerk's CDN directly (simpler but less reliable in some regions)
VITE_CLERK_PROXY_URL=https://yourdomain.com/api/__clerk
